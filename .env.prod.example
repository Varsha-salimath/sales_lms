# =============================================================================
# Sales LMS — PRODUCTION .env (copy to .env on the server)
# =============================================================================
#   cp .env.prod.example .env && chmod 600 .env
#   Fill placeholders from your secret store. Never commit real .env to git.
#   Passwords containing $ MUST use single quotes: DB_PASSWORD='...$...'
#   Deploy: PRODUCTION_DEPLOY.md
# =============================================================================

COMPOSE_PROFILES=

BACKEND_IMAGE=sales-lms-backend:local
FRONTEND_IMAGE=sales-lms-frontend:local
LMS_PULL_POLICY=never

APP_PORT=8080
SOCKETIO_PORT=9000

SITE_NAME=your-site.example.com
HOST_NAME=https://your-app.example.com
ADMIN_PASSWORD=<strong-admin-password>

DEVELOPER_MODE=0
LMS_ALLOW_GUEST_ACCESS=0
LMS_DISABLE_SIGNUP=1
ALLOW_DEMO_LEARNER=0

DB_TYPE=mariadb
DB_HOST=<mariadb-host>
DB_PORT=3306
DB_NAME=salesapp
DB_USER=salesapp
DB_PASSWORD='<db-password-use-single-quotes-if-contains-$>'
DB_ROOT_USERNAME=<db-admin-user>
DB_ROOT_PASSWORD='<db-admin-password>'
DB_USE_SSL=0

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=<strong-compose-redis-password>

SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>
SMTP_TLS=1
SMTP_SSL=0
DEFAULT_SENDER=noreply@example.com
DEFAULT_SENDER_NAME=Sales LMS

UPSTREAM_REAL_IP_ADDRESS=<load-balancer-ip-or-cidr>
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=on
