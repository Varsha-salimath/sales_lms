# =============================================================================
# Sales LMS — PRODUCTION .env (copy to .env on VM: /var/www/saleslms/.env)
# =============================================================================
#   cp .env.prod.example .env && chmod 600 .env
#   Fill <placeholders> only. Never commit real .env or secrets to git.
#   Passwords containing $ MUST use single quotes: DB_PASSWORD='...$...'
#   Deploy: PRODUCTION_DEPLOY.md | DevOps brief: docs/DEVOPS_DEPLOY.md
# =============================================================================

COMPOSE_PROFILES=

BACKEND_IMAGE=sales-lms-backend:local
FRONTEND_IMAGE=sales-lms-frontend:local
LMS_PULL_POLICY=never

# PRODUCTION: LB / ALB / nginx MUST forward to host port 8080 (not 8081, not :8000).
APP_PORT=8080
SOCKETIO_PORT=9000

# Internal Frappe site (folder) name — kept from the original domain; nginx pins it via FRAPPE_SITE_NAME_HEADER,
# so it does not have to match the public domain. Do not rename.
SITE_NAME=saleslms.infinitylearn.com
# Must match public URL (HTTPS). Used by Frappe for links, emails, redirects.
HOST_NAME=https://lms.infinitylearn.com
ADMIN_PASSWORD=<strong-admin-password>

DEVELOPER_MODE=0
LMS_ALLOW_GUEST_ACCESS=0
LMS_DISABLE_SIGNUP=1
ALLOW_DEMO_LEARNER=0

# AWS RDS MariaDB 11.8.8 (POC). Master user is saleslms_admin — not literal "root".
DB_TYPE=mariadb
DB_HOST=<aws-rds-endpoint>
DB_PORT=3306
DB_NAME=saleslms
DB_USER=saleslms_admin
DB_PASSWORD='<rds-password-use-single-quotes-if-contains-$>'
DB_ROOT_USERNAME=saleslms_admin
DB_ROOT_PASSWORD='<rds-password-use-single-quotes-if-contains-$>'
# Required for AWS RDS with require_secure_transport=ON (MySQL error 3159)
DB_USE_SSL=1

# Compose Redis on the VM — REDIS_USERNAME must stay empty. Do NOT use Redis Cloud.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=<strong-compose-redis-password>

SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=<smtp-iam-access-key-id>
SMTP_PASSWORD=<smtp-secret-access-key>
SMTP_TLS=1
SMTP_SSL=0
DEFAULT_SENDER=donotreply@wizklub.com
DEFAULT_SENDER_NAME=Sales LMS

UPSTREAM_REAL_IP_ADDRESS=<load-balancer-ip-or-cidr>
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=on

# Gemini Live viva (backend only). Examiner: gemini-3.8-live
GEMINI_API_KEY=
SARVAM_API_KEY=
