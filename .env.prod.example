# =============================================================================
# Sales LMS — PRODUCTION .env template (copy to .env on the VM)
# =============================================================================
#   cp .env.prod.example .env
#   chmod 600 .env
#   # Fill <placeholders> — DevOps provides DB_* ; never commit real .env
#
# On VM: /var/www/saleslms/.env
# Deploy steps: PRODUCTION_DEPLOY.md
# =============================================================================

# Empty = no embedded MariaDB container (use external AWS MariaDB 11.8.8)
COMPOSE_PROFILES=

BACKEND_IMAGE=sales-lms-backend:local
FRONTEND_IMAGE=sales-lms-frontend:local
LMS_PULL_POLICY=never
APP_PORT=8080
SOCKETIO_PORT=9000

# --- Site (SITE_NAME must NOT equal DB_NAME) ---
SITE_NAME=saleslms.infinitylearn.com
HOST_NAME=https://saleslms.infinitylearn.com
ADMIN_PASSWORD=<strong-admin-password>

# --- Security (production) ---
DEVELOPER_MODE=0
LMS_ALLOW_GUEST_ACCESS=0
LMS_DISABLE_SIGNUP=1
ALLOW_DEMO_LEARNER=0

# --- MariaDB (AWS POC — MariaDB 11.8.8, port 3306) ---
# DevOps fills DB_HOST and passwords. Root must CREATE DATABASE on first boot.
DB_TYPE=mariadb
DB_HOST=<aws-mariadb-host-from-devops>
DB_PORT=3306
DB_NAME=salesapp
DB_USER=salesapp
DB_PASSWORD=<salesapp-runtime-password-from-devops>
DB_ROOT_USERNAME=root
DB_ROOT_PASSWORD=<mariadb-root-password-from-devops>

# --- Redis (use Compose Redis — NOT Redis Cloud; Frappe 16 CLIENT TRACKING breaks) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=<strong-compose-redis-password>

# --- SMTP (AWS SES ap-south-1) ---
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=<smtp-iam-access-key-id>
SMTP_PASSWORD=<smtp-secret-access-key>
SMTP_TLS=1
SMTP_SSL=0
DEFAULT_SENDER=donotreply@wizklub.com
DEFAULT_SENDER_NAME=Sales LMS

# --- nginx real-IP (set to load balancer / reverse proxy IP or CIDR) ---
UPSTREAM_REAL_IP_ADDRESS=<lb-or-proxy-ip-or-cidr>
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=on
