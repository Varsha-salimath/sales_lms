# =============================================================================
# Sales LMS — .gitignore (Bitbucket / production handover)
# =============================================================================

# macOS / editors
.DS_Store
*.swp
*~
.idea/
.vscode/
*.code-workspace

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
.tox/
.venv/
venv/
env/

# Node / frontend
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnp.*

# Build artifacts
dist/
**/dist/
build/
**/build/
.vite/
.turbo/
*.tsbuildinfo
frontend/dist/
lms/public/dist/
lms/public/frontend/
lms/www/lms.html
lms/www/_lms.html
coverage/
*.map

# Frappe bench local (if present in clone)
sites/
archived/
env/
config/
Procfile
logs/
*.log
**/logs/

# -----------------------------------------------------------------------------
# Environment / secrets — never commit real values
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
docker/.env
docker/.env.*
*.secret
secrets/
.secrets/

# -----------------------------------------------------------------------------
# TLS / SSL certificates & private keys (not the LMS certificate PNG template)
# -----------------------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.csr
!*.example.crt
id_rsa
id_rsa.pub
*.jks
certs/
# Root-level SSL material only — do NOT ignore frontend/src/pages/Certificates/
/certificates/
ssl/
!frontend/src/pages/Certificates/
!frontend/src/pages/Certificates/**
**/letsencrypt/

# Generated learner certificates (local exports)
**/Certificate-*.pdf
**/Certificate-*.png
!lms/public/images/genius-certificate-copilot.png
!lms/public/images/genius-certificate-layout.json

# -----------------------------------------------------------------------------
# Uploaded SCORM packages & extracts (runtime site data — not source)
# -----------------------------------------------------------------------------
**/public/scorm/
**/private/scorm/
**/scorm_packages/
**/scorm-uploads/
sites/**/public/files/*.zip
sites/**/private/files/*.zip

# Local uploaded media / files (bench sites)
sites/**/public/files/
sites/**/private/files/
sites/**/locks/
sites/**/logs/
sites/**/*.log

# -----------------------------------------------------------------------------
# Docker / local ops leftovers
# -----------------------------------------------------------------------------
*.tar
*.tar.gz
*.tgz

# Cypress / test artifacts
cypress/videos/
cypress/screenshots/
cypress/downloads/

# Dev scratch (sensitive CRM / schedule dumps — not source)
data/_*

# CRT workbook — internal SharePoint / form links; obtain from secure share (not public git)
data/CRT-Schedule.xlsx
backend/lms/lms/data/CRT-Schedule.xlsx
**/CRT-Schedule.xlsx

# Misc
tags
frappe-ui
frappe-semgrep-rules
lms/docs/current
package-lock.json
Thumbs.db
desktop.ini
