{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Infinity Learn LMS design tokens (W3C DTCG format). Source of truth for code (frontend/src/styles/sales-theme.css) and Figma variables in the file 'LMS Infinity Learn — Design System'. Every token lists the CSS variable that implements it in $extensions.css.",
  "color": {
    "primitive": {
      "$description": "Raw brand palette. Do not use directly in components; use color.semantic.* instead.",
      "blue": {
        "10": { "$type": "color", "$value": "#00254C", "$extensions": { "css": "--il-primary-10" } },
        "20": { "$type": "color", "$value": "#013166", "$extensions": { "css": "--il-primary-20" } },
        "30": { "$type": "color", "$value": "#004A99", "$extensions": { "css": "--il-primary-30" } },
        "40": { "$type": "color", "$value": "#0062CC", "$extensions": { "css": "--il-primary-40" } },
        "50": { "$type": "color", "$value": "#027BFF", "$extensions": { "css": "--il-primary-50" } },
        "90": { "$type": "color", "$value": "#CCE5FF", "$extensions": { "css": "--il-primary-90" } },
        "95": { "$type": "color", "$value": "#E6F2FF", "$extensions": { "css": "--il-primary-95" } },
        "98": { "$type": "color", "$value": "#F4F9FF", "$description": "Section header strips, selected list rows." }
      },
      "yellow": {
        "50": { "$type": "color", "$value": "#FCDE5A", "$extensions": { "css": "--il-secondary-50" } },
        "95": { "$type": "color", "$value": "#FFFCEF", "$extensions": { "css": "--il-secondary-95" } }
      },
      "orange": {
        "50": { "$type": "color", "$value": "#FF7900", "$extensions": { "css": "--il-tertiary-50" } },
        "95": { "$type": "color", "$value": "#FFE4CC", "$extensions": { "css": "--il-tertiary-95" } }
      },
      "green": {
        "50": { "$type": "color", "$value": "#04742D", "$extensions": { "css": "--il-success-50" } },
        "60": { "$type": "color", "$value": "#35C759", "$extensions": { "css": "--il-success-60" } },
        "95": { "$type": "color", "$value": "#D6F4DE", "$extensions": { "css": "--il-success-95" } }
      },
      "amber": {
        "50": { "$type": "color", "$value": "#B36E00", "$extensions": { "css": "--il-warning-50" } },
        "95": { "$type": "color", "$value": "#FFEECC", "$extensions": { "css": "--il-warning-95" } }
      },
      "red": {
        "50": { "$type": "color", "$value": "#F03E3E", "$extensions": { "css": "--il-error-50" } },
        "95": { "$type": "color", "$value": "#FEF0F0", "$extensions": { "css": "--il-error-95" } }
      },
      "violet": {
        "50": { "$type": "color", "$value": "#5B3FD6", "$description": "Manager role badge text only." },
        "95": { "$type": "color", "$value": "#EFEBFF" }
      },
      "neutral": {
        "0": { "$type": "color", "$value": "#080E14", "$extensions": { "css": "--il-ink" } },
        "40": { "$type": "color", "$value": "#52565C", "$extensions": { "css": "--il-neutral-40" } },
        "60": { "$type": "color", "$value": "#85878A", "$extensions": { "css": "--il-neutral-60" } },
        "80": { "$type": "color", "$value": "#CECFD0", "$extensions": { "css": "--il-neutral-80" } },
        "90": { "$type": "color", "$value": "#E6E7E8", "$extensions": { "css": "--il-neutral-90" } },
        "95": { "$type": "color", "$value": "#F2F2F2", "$extensions": { "css": "--il-neutral-95" } },
        "100": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "css": "--il-paper" } }
      }
    },
    "semantic": {
      "$description": "Use these in components. Names describe purpose, not hue.",
      "brand": { "$type": "color", "$value": "{color.primitive.blue.50}", "$description": "Primary buttons, active chips, 'Today' pill, links on white. The one brand colour." },
      "brand-strong": { "$type": "color", "$value": "{color.primitive.blue.40}", "$description": "Link text, active sidebar item text, hover state of brand." },
      "brand-navy": { "$type": "color", "$value": "{color.primitive.blue.10}", "$description": "Hero banner, selected filter chip, Super Admin badge." },
      "brand-soft": { "$type": "color", "$value": "{color.primitive.blue.95}", "$description": "Tinted backgrounds for brand things (team chips, avatars)." },
      "brand-strip": { "$type": "color", "$value": "{color.primitive.blue.98}", "$description": "Card header strips and the current journey row." },
      "accent": { "$type": "color", "$value": "{color.primitive.yellow.50}", "$description": "Progress ring and streak bar only. Never text on white." },
      "text": { "$type": "color", "$value": "{color.primitive.neutral.0}", "$description": "Body and heading text." },
      "text-muted": { "$type": "color", "$value": "{color.primitive.neutral.40}", "$description": "Secondary text, captions, emails, meta." },
      "text-subtle": { "$type": "color", "$value": "{color.primitive.neutral.60}", "$description": "Placeholders, disabled, separators in breadcrumbs." },
      "text-on-brand": { "$type": "color", "$value": "{color.primitive.neutral.100}" },
      "surface": { "$type": "color", "$value": "{color.primitive.neutral.100}", "$description": "Page panel and cards." },
      "surface-muted": { "$type": "color", "$value": "{color.primitive.neutral.95}", "$description": "Neutral pills (Locked, Learner), inputs on white." },
      "border": { "$type": "color", "$value": "{color.primitive.neutral.90}", "$description": "Card borders, dividers, unselected chips." },
      "success": { "$type": "color", "$value": "{color.primitive.green.50}", "$description": "'Done' text, positive deltas." },
      "success-soft": { "$type": "color", "$value": "{color.primitive.green.95}", "$description": "'Done' pill and completed-step circle background." },
      "warning": { "$type": "color", "$value": "{color.primitive.amber.50}" },
      "warning-soft": { "$type": "color", "$value": "{color.primitive.amber.95}", "$description": "Team admin badge, lock notices." },
      "danger": { "$type": "color", "$value": "{color.primitive.red.50}", "$description": "Errors and destructive actions only." },
      "danger-soft": { "$type": "color", "$value": "{color.primitive.red.95}" }
    },
    "band": {
      "$description": "Score bands used in every report. Cut-offs: >=90% excellent, 80-90% good, 60-80% average, <60% needs improvement. Source: frontend/src/pages/Reports/reportUtils.js BAND_STYLES.",
      "excellent": { "bg": { "$type": "color", "$value": "#8ADB9F" }, "soft": { "$type": "color", "$value": "#E7F8EC" }, "text": { "$type": "color", "$value": "#0B5A24" }, "solid": { "$type": "color", "$value": "#34B35A" } },
      "good": { "bg": { "$type": "color", "$value": "#C9F0D4" }, "soft": { "$type": "color", "$value": "#F0FBF3" }, "text": { "$type": "color", "$value": "#146C31" }, "solid": { "$type": "color", "$value": "#6CCB86" } },
      "average": { "bg": { "$type": "color", "$value": "#FFE8B3" }, "soft": { "$type": "color", "$value": "#FFF8E6" }, "text": { "$type": "color", "$value": "#8A5A00" }, "solid": { "$type": "color", "$value": "#F5A300" } },
      "needs-improvement": { "bg": { "$type": "color", "$value": "#FFD4D4" }, "soft": { "$type": "color", "$value": "#FFF1F1" }, "text": { "$type": "color", "$value": "#B42323" }, "solid": { "$type": "color", "$value": "#EF6461" } },
      "not-scored": { "bg": { "$type": "color", "$value": "#E6E7E8" }, "soft": { "$type": "color", "$value": "#F7F7F7" }, "text": { "$type": "color", "$value": "#85878A" }, "solid": { "$type": "color", "$value": "#A9ABAD" } }
    }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Poppins", "Segoe UI", "sans-serif"], "$description": "Only typeface. Load weights 400, 500, 600." }
  },
  "typography": {
    "$description": "Measured from the live app. Letter-spacing is +0.02em throughout (0.28px at 14px).",
    "page-title": { "$type": "typography", "$value": { "fontFamily": "Poppins", "fontSize": "28px", "fontWeight": 600, "lineHeight": "36px", "letterSpacing": "0.01em" }, "$description": "One per page, top left: 'Home', 'Team & access'." },
    "hero-title": { "$type": "typography", "$value": { "fontFamily": "Poppins", "fontSize": "28px", "fontWeight": 600, "lineHeight": "34px", "letterSpacing": "0" }, "$description": "White text on the navy hero banner." },
    "section-title": { "$type": "typography", "$value": { "fontFamily": "Poppins", "fontSize": "18px", "fontWeight": 600, "lineHeight": "24px", "letterSpacing": "0.01em" }, "$description": "Card and section headings." },
    "row-title": { "$type": "typography", "$value": { "fontFamily": "Poppins", "fontSize": "15px", "fontWeight": 500, "lineHeight": "22px", "letterSpacing": "0.02em" }, "$description": "List rows, journey steps, tabs." },
    "body": { "$type": "typography", "$value": { "fontFamily": "Poppins", "fontSize": "14px", "fontWeight": 400, "lineHeight": "21px", "letterSpacing": "0.02em" } },
    "body-strong": { "$type": "typography", "$value": { "fontFamily": "Poppins", "fontSize": "14px", "fontWeight": 500, "lineHeight": "21px", "letterSpacing": "0.02em" }, "$description": "Names in tables, sidebar items." },
    "button": { "$type": "typography", "$value": { "fontFamily": "Poppins", "fontSize": "14px", "fontWeight": 600, "lineHeight": "20px", "letterSpacing": "0.02em" } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "Poppins", "fontSize": "12px", "fontWeight": 400, "lineHeight": "16px", "letterSpacing": "0.02em" }, "$description": "Sub-lines under row titles, emails, meta." },
    "label": { "$type": "typography", "$value": { "fontFamily": "Poppins", "fontSize": "12px", "fontWeight": 600, "lineHeight": "18px", "letterSpacing": "0.02em" }, "$description": "Pills, badges, counters." },
    "overline": { "$type": "typography", "$value": { "fontFamily": "Poppins", "fontSize": "12px", "fontWeight": 600, "lineHeight": "14px", "letterSpacing": "0.08em", "textTransform": "uppercase" }, "$description": "Sidebar group headings (PRACTICE HUB)." }
  },
  "spacing": {
    "$description": "4px grid.",
    "1": { "$type": "dimension", "$value": "4px" }, "2": { "$type": "dimension", "$value": "8px" }, "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" }, "5": { "$type": "dimension", "$value": "20px" }, "6": { "$type": "dimension", "$value": "24px" },
    "7": { "$type": "dimension", "$value": "28px" }, "8": { "$type": "dimension", "$value": "32px" }, "10": { "$type": "dimension", "$value": "40px" }, "12": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px", "$description": "Icon buttons, inputs inside cards." },
    "md": { "$type": "dimension", "$value": "12px", "$extensions": { "css": "--il-radius-sm" }, "$description": "Tiles, inner boxes." },
    "lg": { "$type": "dimension", "$value": "16px", "$description": "List rows (journey step)." },
    "xl": { "$type": "dimension", "$value": "20px", "$description": "Report header card, sidebar cards." },
    "2xl": { "$type": "dimension", "$value": "24px", "$extensions": { "css": "--il-radius" }, "$description": "Cards, hero banner." },
    "pill": { "$type": "dimension", "$value": "999px", "$description": "Every button, chip, pill and badge." }
  },
  "shadow": {
    "soft": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "12px", "spread": "0px", "color": "#0000001F" }, "$extensions": { "css": "--il-shadow-soft" }, "$description": "Cards." },
    "chip": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "4px", "spread": "0px", "color": "#00000029" }, "$description": "Active sidebar item, floating pill buttons." },
    "hover": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "20px", "spread": "0px", "color": "#00000029" }, "$description": "Card hover (with translateY(-2px))." }
  },
  "size": {
    "control-height": { "$type": "dimension", "$value": "44px", "$description": "Primary/secondary buttons." },
    "chip-height": { "$type": "dimension", "$value": "40px", "$description": "Filter chips, sidebar items." },
    "pill-height": { "$type": "dimension", "$value": "24px", "$description": "Status pills and badges." },
    "sidebar-width": { "$type": "dimension", "$value": "240px" },
    "content-max": { "$type": "dimension", "$value": "1112px", "$description": "Content column inside the white panel at 1440." }
  },
  "breakpoint": {
    "mobile": { "$type": "dimension", "$value": "390px" }, "tablet": { "$type": "dimension", "$value": "768px" }, "desktop": { "$type": "dimension", "$value": "1440px" }
  }
}
