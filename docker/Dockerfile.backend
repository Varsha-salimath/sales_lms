# Sales LMS — BACKEND image (Frappe + LMS app + built SPA assets).
# Build from repo root:
#   docker build -f docker/Dockerfile.backend -t sales-lms-backend:local .
#
# backend/ → apps/lms   |   frontend/ → apps/lms/frontend

FROM ghcr.io/frappe/lms:stable

USER root
RUN rm -rf /home/frappe/frappe-bench/apps/lms

COPY backend/ /home/frappe/frappe-bench/apps/lms/
COPY frontend/ /home/frappe/frappe-bench/apps/lms/frontend/
COPY data/ /opt/sales-lms/data/

RUN chmod -R u+rwX /home/frappe/frappe-bench/apps/lms \
	&& chown -R frappe:frappe /home/frappe/frappe-bench/apps/lms \
	&& if [ -d /home/frappe/.nvm ]; then chown -R frappe:frappe /home/frappe/.nvm; fi

USER frappe
WORKDIR /home/frappe/frappe-bench

RUN set -e; \
	TRACKING=apps/lms/lms/tracking.py; \
	test -f "$TRACKING"; \
	grep -q 'WHERE `user` = %s AND `date` BETWEEN %s AND %s' "$TRACKING"; \
	! grep -nE 'YEAR\(`date`\)[[:space:]]*=' "$TRACKING"; \
	echo "OK: Postgres-compatible tracking SQL present in image source."

RUN ["/bin/bash", "-c", "set -e; export NVM_DIR=\"${NVM_DIR:-$HOME/.nvm}\"; [ -s \"$NVM_DIR/nvm.sh\" ]; . \"$NVM_DIR/nvm.sh\"; nvm install 24; nvm alias default 24; nvm use 24; ln -sfn \"$NVM_DIR/versions/node/$(nvm version)\" \"$NVM_DIR/versions/node/default\"; npm install -g yarn@1.22.22; if [ ! -d apps/payments ]; then git clone --depth 1 --branch version-16 https://github.com/frappe/payments.git apps/payments; fi; ./env/bin/pip install --no-cache-dir -e ./apps/payments; ./env/bin/pip install --no-cache-dir -e ./apps/lms; ./env/bin/pip install --no-cache-dir openpyxl; mkdir -p apps/lms/frontend/node_modules apps/lms/node_modules; yarn --cwd ./apps/lms install --frozen-lockfile; bench build --app lms; ls -1 apps > sites/apps.txt; ./env/bin/python -c \"import frappe; print('frappe', frappe.__version__)\"; ./env/bin/python -c \"import lms; print('lms', getattr(lms,'__version__', 'unknown'))\""]

ENV PATH="/home/frappe/.nvm/versions/node/default/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/sbin:/bin"

# sites/assets -> /home/frappe/frappe-bench/assets (outside sites volume).
# Bake LMS public symlink so frontend nginx can serve /assets/lms/* without a shared volume.
USER root
RUN ln -sfn /home/frappe/frappe-bench/apps/lms/lms/public /home/frappe/frappe-bench/assets/lms \
	&& mkdir -p /home/frappe/frappe-bench/apps/lms/www \
	&& cp -f /home/frappe/frappe-bench/apps/lms/lms/public/frontend/index.html /home/frappe/frappe-bench/apps/lms/www/_lms.html \
	&& chown -R frappe:frappe /home/frappe/frappe-bench/assets/lms /home/frappe/frappe-bench/apps/lms/www
USER frappe
