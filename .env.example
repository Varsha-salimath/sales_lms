# =============================================================================
# Sales LMS — single env (local + prod). Same keys; change values for prod.
# =============================================================================
#   cp .env.example .env
#   docker compose --env-file .env build backend
#   docker compose --env-file .env build frontend
#   docker compose --env-file .env up -d
#
# PRODUCTION ANTI-FOOTGUNS (do not skip):
# 1) SITE_NAME must NOT equal DB_NAME. Site is a hostname; DB is salesapp.
# 2) DB_ROOT_USERNAME must NOT equal the app DB user/name (salesapp).
#    Root must be able to CREATE DATABASE. App user is runtime only.
# 3) Never half-create a site then point it at a different DB without
#    cleaning site_config + the empty DB carefully. Ask before any wipe.
# 4) Redis: Frappe 16 is incompatible with Redis Cloud CLIENT TRACKING
#    ("syntax error"). Default/recommended: Compose Redis
#    (REDIS_HOST=redis, port 6379). Do not assume managed Redis works.
# 5) Only frontend nginx publishes APP_PORT. Backend/redis/db stay internal.
#    Public LB/proxy MUST target APP_PORT (8080), not uvicorn directly.
# 6) SMTP is required from day one. Compose fails fast if SMTP secrets missing.
# 7) Docker image/code deploy does NOT bring CRT courses. Import Excel after boot.
# 8) APP_PORT is 8080 for local AND prod. Do not invent a different publish port.
# =============================================================================

# Start in-compose Postgres (clear on prod when using external DB)
COMPOSE_PROFILES=embedded-db

# --- Images ---
BACKEND_IMAGE=sales-lms-backend:local
FRONTEND_IMAGE=sales-lms-frontend:local
LMS_PULL_POLICY=never
APP_PORT=8080
SOCKETIO_PORT=9000

# --- Site ---
# SITE_NAME ≠ DB_NAME. Example: sales.localhost vs salesapp
SITE_NAME=sales.localhost
HOST_NAME=http://localhost:8080
ADMIN_PASSWORD=admin

# --- Security (local dev: relaxed; prod: see comments below) ---
DEVELOPER_MODE=1
LMS_ALLOW_GUEST_ACCESS=1
LMS_DISABLE_SIGNUP=0
ALLOW_DEMO_LEARNER=1

# --- PostgreSQL ---
# Root (superuser) connects to DB "postgres" for bench new-site.
# App user/db = salesapp (created by Frappe). Do not set root user == site DB name.
DB_TYPE=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=salesapp
DB_USER=salesapp
DB_PASSWORD=sales_local_pg_change_me
DB_ROOT_USERNAME=postgres
DB_ROOT_PASSWORD=sales_local_pg_change_me

# Prod example:
# COMPOSE_PROFILES=
# APP_PORT=8080
# SITE_NAME=saleslms.infinitylearn.com
# HOST_NAME=https://saleslms.infinitylearn.com
# ADMIN_PASSWORD=<strong-secret>
# DEVELOPER_MODE=0
# LMS_ALLOW_GUEST_ACCESS=0
# LMS_DISABLE_SIGNUP=1
# ALLOW_DEMO_LEARNER=0
# DB_HOST=<cloud-sql-private-ip>
# DB_ROOT_USERNAME=postgres   # privileged role that can CREATE DATABASE — NOT salesapp
# DB_ROOT_PASSWORD=...
# DB_PASSWORD=...
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_USER=...
# SMTP_PASSWORD=...
# DEFAULT_SENDER=donotreply@wizklub.com
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=<compose-redis-password>

# --- Redis ---
# Known-good path: Compose Redis (REDIS_HOST=redis, port 6379, password only).
# Leave REDIS_USERNAME empty for Compose Redis.
# Optional ACL fields exist for a proven-compatible external Redis — do not
# default to Redis Cloud (Frappe 16 CLIENT TRACKING incompatibility).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=sales_local_redis
# Optional full URI overrides (otherwise built from REDIS_USERNAME/PASSWORD/HOST/PORT):
# REDIS_CACHE=redis://user:pass@host:6379?protocol=3
# REDIS_QUEUE=redis://user:pass@host:6379?protocol=3
# REDIS_SOCKETIO=redis://user:pass@host:6379?protocol=3

# --- SMTP (required) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change_me
SMTP_TLS=1
SMTP_SSL=0
DEFAULT_SENDER=donotreply@wizklub.com
DEFAULT_SENDER_NAME=Sales LMS

# --- nginx real-IP ---
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
